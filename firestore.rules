rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role-Based Access Control: Admin check with runtime bootstrapped admin support
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'javasamip@gmail.com' ||
          request.auth.token.email == 'admin@geminijournal.app'
        ))
      );
    }

    // Admin reference documents
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin audit logs (accessible by administrators)
    match /admin_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // User data isolation and directory management
    match /users/{userId} {
      // Admins can read all user records; users can read their own
      allow read: if isOwner(userId) || isAdmin();
      
      // User creation: Users can create their own profile, Admins can create profiles
      allow create: if isOwner(userId) || isAdmin();

      // Updates: Admins can update any user status/role.
      // Non-admin users can update their profile but CANNOT self-promote to admin or alter activation status
      allow update: if isAdmin() || (
        isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']))
      );

      allow delete: if isAdmin();

      // Subcollections (entries, streaks, digests, interactions)
      match /{subcollection=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
