rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role-Based Access Control: Admin check with dynamic document lookup & verified role claims
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.role == 'admin')
      );
    }

    // Admin reference documents
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin audit logs (accessible by administrators)
    match /admin_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // Deactivation appeals submitted by users requesting account review
    match /appeals/{appealId} {
      // Authenticated users can submit an appeal for their own user ID or email
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.userEmail == request.auth.token.email || isAdmin());
      // Users can read their own appeal status; Admins can read all appeals
      allow read: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email));
      // Admins can update any field (approve/reject/notes/replies)
      // Users who own the appeal can update to add replies/messages to the conversation thread
      allow update: if isAdmin() || (
        isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'reviewedBy', 'reviewedAt', 'userId'])
      );
      allow delete: if isAdmin();

      // Threaded conversation messages subcollection in appeal
      match /messages/{messageId} {
        allow read: if isAdmin() || (isSignedIn() && (get(/databases/$(database)/documents/appeals/$(appealId)).data.userId == request.auth.uid || get(/databases/$(database)/documents/appeals/$(appealId)).data.userEmail == request.auth.token.email));
        allow create: if isAdmin() || (isSignedIn() && (get(/databases/$(database)/documents/appeals/$(appealId)).data.userId == request.auth.uid || get(/databases/$(database)/documents/appeals/$(appealId)).data.userEmail == request.auth.token.email));
        allow update, delete: if isAdmin();
      }
    }

    // Top-level conversations collection (user reflections & chat exchanges)
    match /conversations/{conversationId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    // User data isolation and directory management
    match /users/{userId} {
      // Admins can read all user records; users can read their own
      allow read: if isOwner(userId) || isAdmin();
      
      // User creation: Users can create their own profile, Admins can create profiles
      allow create: if isOwner(userId) || isAdmin();

      // Updates: Admins can update any user status/role.
      // Non-admin users can update their profile but CANNOT self-promote to admin or alter activation status
      allow update: if isAdmin() || (
        isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']))
      );

      allow delete: if isAdmin();

      // Subcollections (entries, streaks, digests, interactions)
      match /{subcollection=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
