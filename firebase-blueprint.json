{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile, role, and activation status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["active", "deactivated"] },
        "createdAt": { "type": "number" },
        "lastLoginAt": { "type": "number" },
        "deactivatedAt": { "type": "number" },
        "deactivatedBy": { "type": "string" },
        "deactivationReason": { "type": "string" }
      },
      "required": ["uid", "email", "role", "status", "createdAt"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "User journal reflection entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Audit trail of admin operations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminUid": { "type": "string" },
        "adminEmail": { "type": "string" },
        "targetUid": { "type": "string" },
        "targetEmail": { "type": "string" },
        "action": { "type": "string", "enum": ["activate", "deactivate", "role_change", "user_created"] },
        "details": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "adminUid", "adminEmail", "targetUid", "targetEmail", "action", "timestamp"]
    },
    "DeactivationAppeal": {
      "title": "DeactivationAppeal",
      "description": "Appeal submitted by deactivated user requesting account review and reactivation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "deactivationReason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "approved", "rejected"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "number" },
        "adminNotes": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "subject", "message", "status", "createdAt"]
    },
    "AppealMessage": {
      "title": "AppealMessage",
      "description": "Individual message in an appeal conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderEmail": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["admin", "user"] },
        "message": { "type": "string" },
        "sentAt": { "type": "number" },
        "emailDispatched": { "type": "boolean" }
      },
      "required": ["id", "senderEmail", "senderName", "message", "sentAt"]
    },
    "UserConversation": {
      "title": "UserConversation",
      "description": "Conversation thread between user and Gemini assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "entryId": { "type": "string" },
        "title": { "type": "string" },
        "messages": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "messages", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account document"
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": "JournalEntry",
      "description": "User reflections subcollection"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "UserConversation",
      "description": "User reflection conversations"
    },
    "/admin_audit_logs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Immutable log of administrative actions"
    },
    "/admins/{adminId}": {
      "schema": "UserProfile",
      "description": "Admin authorization reference marker"
    },
    "/appeals/{appealId}": {
      "schema": "DeactivationAppeal",
      "description": "User appeals for deactivated account reactivation"
    },
    "/appeals/{appealId}/messages/{messageId}": {
      "schema": "AppealMessage",
      "description": "Threaded conversation messages for account appeal"
    }
  }
}
