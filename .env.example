# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Secret Manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

VITE_PROD="true"

# Firebase Client Configuration (Rotated from Secret Manager or environment)
# These values can be populated via build args or Secret Manager in production.
VITE_FIREBASE_API_KEY="AIzaSy_ROTATED_KEY_HERE"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0012116236.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0012116236"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0012116236.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="890770180664"
VITE_FIREBASE_APP_ID="1:890770180664:web:08b8e6449559a0bf43b4cd"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-geminireflection-ab2ff0c8-b52f-4e79-ace8-f54b69293c0d"

# System Administrator & Governance Secrets (GCP Secret Manager or Server Environment)
# In production, these should be provisioned in Google Cloud Secret Manager (ADMIN_EMAIL, ADMIN_PASSWORD)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_AUTHORIZED_EMAILS=

# Optional Email Delivery Configuration (for Weekly Digest Saturday automated dispatch)
# If provided, real emails will be sent via SMTP/mail server. If omitted, local mock/test delivery is used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE="false"
SMTP_FROM="Gemini Reflection Journal <journal@geminiapp.com>"
